# =============================================================================
# MARCUS DOCKER TEST ENVIRONMENT
# =============================================================================
# Copy this file and fill in your secrets:
#   cp .env.test.example .env.test
#
# Then run:
#   docker compose -f docker-compose.test.yml --env-file .env.test up --build
# =============================================================================

# --------------- TIER 1: SECRETS (never hardcode in compose files) -----------

# AI Provider (required — pick one)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Planka credentials
PLANKA_EMAIL=demo@demo.demo
PLANKA_PASSWORD=demo

# Postgres credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
