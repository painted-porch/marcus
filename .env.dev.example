# =====================================================
# Marcus Development Environment - FREE LOCAL SETUP
# =====================================================
#
# This configuration uses 100% FREE local models for development.
# No API keys required! Perfect for contributors.
#
# Setup Instructions:
# 1. Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Pull model: ollama pull qwen2.5-coder:7b
# 3. Copy this file: cp .env.dev.example .env
# 4. Start developing!

# AI Provider Configuration (Local - FREE)
# =========================================
# Use Qwen2.5-Coder for excellent code understanding at zero cost
MARCUS_LLM_PROVIDER=local
MARCUS_LOCAL_LLM_PATH=qwen2.5-coder:7b
MARCUS_LOCAL_LLM_URL=http://localhost:11434/v1
# MARCUS_LOCAL_LLM_KEY=none  # Optional, Ollama doesn't need auth

# Alternative Free Models (uncomment to use):
# MARCUS_LOCAL_LLM_PATH=deepseek-coder:6.7b  # Also excellent for code
# MARCUS_LOCAL_LLM_PATH=codellama:7b         # Faster, lighter
# MARCUS_LOCAL_LLM_PATH=mistral:7b           # Good general purpose

# Kanban Configuration (Planka - Running in Docker)
# ==================================================
# These values work with the default docker-compose setup
MARCUS_KANBAN_PROVIDER=planka
MARCUS_KANBAN_PLANKA_BASE_URL=http://localhost:3333
MARCUS_KANBAN_PLANKA_EMAIL=demo@demo.demo
MARCUS_KANBAN_PLANKA_PASSWORD=demo

# Project Configuration
# ======================
# Get these from Planka after creating a project:
# 1. Create project in Planka: http://localhost:3333
# 2. Note project ID from URL: /projects/PROJECT_ID
# 3. Create board and note board ID from URL: /boards/BOARD_ID
# MARCUS_PROJECT_ID=your-project-id-here
# MARCUS_BOARD_ID=your-board-id-here
# MARCUS_PROJECT_NAME=My Development Project

# Development Features
# ====================
# Enable helpful features for development
MARCUS_FEATURES_EVENTS=true
MARCUS_FEATURES_CONTEXT=true
MARCUS_FEATURES_MEMORY=false
MARCUS_FEATURES_VISIBILITY=false

# Logging
# =======
# Set to DEBUG for detailed logs during development
MARCUS_LOG_LEVEL=INFO

# =====================================================
# Optional: Paid API Keys (if you want to use them)
# =====================================================
# Uncomment and add keys if you prefer paid providers:
# MARCUS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# OR
# MARCUS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# =====================================================
# Notes for Contributors
# =====================================================
# - This setup costs $0 to run
# - Qwen2.5-Coder rivals GPT-4 for coding tasks
# - Runs on 8GB RAM (7B model)
# - For 16GB+ RAM, try qwen2.5-coder:14b or deepseek-coder:33b
# - For debugging: MARCUS_LOG_LEVEL=DEBUG
# - See docs/source/getting-started/setup-local-llm.md for more options
